# Copy to .env.production and fill in real values:
#   cp .env.production.example .env.production
#
# .env.production is the source of truth for the production-like local run
# (`make prod`). The API serves the built Astro files itself, so there is no
# separate frontend container and no PUBLIC_API_URL to configure.

PROJECT_NAME=peonveloz

# Host port for the single API + static origin (container listens on 8081).
API_PORT=8081
REDIS_PORT=6379

# Public origins of the deployed site. FRONTEND_URL is the CORS allowlist.
FRONTEND_URL=https://peonveloz.com
PUBLIC_URL=https://peonveloz.com

# Required secrets. Compose fails fast when these are empty.
CSRF_SECRET=change-this-in-production
TOKEN_SIGNING_KEY=change-this-in-production
LICHESS_CLIENT_ID=change-this-in-production
PUSH_NOTIFICATION_API_KEY=change-this-in-production

REDIS_URL=redis://redis:6379
SQLITE_PATH=/app/data/app.db

# WhatsApp Cloud API. Leave blank to disable message sending.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_URL=https://graph.facebook.com/v22.0
