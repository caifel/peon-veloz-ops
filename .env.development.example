# Copy to .env.development and fill in the values:
#   cp .env.development.example .env.development
#
# .env.development is the source of truth for the Docker dev stack (`make up`).

PROJECT_NAME=peonveloz

# Absolute host paths to the sibling repos. These are bind-mounted into the
# containers, so edits on the host are picked up live.
UI_PATH=/absolute/path/to/peonveloz/ui-astro
API_PATH=/absolute/path/to/peonveloz/api

# Host ports. UI_PORT/API_PORT must match the app defaults (Astro 4321, API 4000).
UI_PORT=4321
API_PORT=4000
REDIS_PORT=6379

# CORS allowlist. Must match the browser origin exactly, including scheme and
# port. Comma-separate multiple origins (e.g. localhost plus a LAN IP).
FRONTEND_URL=http://localhost:4321
PUBLIC_URL=http://localhost:4321

# Development secrets. Replace before running anything production-like.
CSRF_SECRET=dev-csrf-secret-change-before-production
TOKEN_SIGNING_KEY=dev-token-signing-key-change-before-production

REDIS_URL=redis://redis:6379
SQLITE_PATH=/peonveloz/api/data/app.db

# Integrations. Keep these non-empty so Compose can start; dev values are fine.
LICHESS_CLIENT_ID=dev-lichess-client-id
PUSH_NOTIFICATION_API_KEY=dev-push-notification-key
WHATSAPP_VERIFY_TOKEN=dev-whatsapp-verify-token
WHATSAPP_APP_SECRET=dev-whatsapp-app-secret
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número público del bot, formato internacional sin '+' (ej: 59175073092).
# Es el que se usa en los links wa.me de la página del torneo — NO es el ID de Meta.
WHATSAPP_PUBLIC_PHONE=59175073092
WHATSAPP_API_URL=https://graph.facebook.com/v22.0
